# This file is documentation only -- there is no real .env anywhere for
# this repo. Deployment is entirely CI-driven (see README.md); these two
# values are Woodpecker repo-scoped secrets, injected as environment
# variables into the CI step, not read from a file.
#
# Everything else this service needs (server name, map, gamemode, bot
# settings, adapter port, etc.) is not secret and lives as literal values
# directly in docker-compose.yml -- there's no other config file to look at.

# Steam Game Server Login Token for App ID 730 (CS2). Obtain from
# https://steamcommunity.com/dev/managegameservers -- must be generated by
# a human with a Steam account, not something that can be created for you.
SRCDS_TOKEN=

# RCON password for this server.
CS2_RCONPW=
